# Template for local development. Copy to .env and fill in only what your
# task actually needs -- see docs/local-dev-and-team-onboarding.md for which
# variables each kind of task requires. Never commit a real .env; it's
# gitignored for a reason.

# --- Database (staging-only for local dev -- see onboarding doc §1) ---
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=eoxs_wiki_staging
PGUSER=
PGPASSWORD=

# --- Anthropic (LLM calls: tier classification, redaction) ---
# Use your OWN personal API key for local dev, never the production key.
ANTHROPIC_API_KEY=
CLASSIFIER_ANTHROPIC_API_KEY=

# --- Linear (EDB team reporting) ---
LINEAR_EDB_API_KEY=
LINEAR_EDB_TEAM_KEY=

# --- Raw-ingestion source credentials (only needed if you're working on a
# specific fetcher -- use a sandbox/test account for that source, never the
# production credential, per source) ---
RAJ_GMAIL_CLIENT_ID=
RAJ_GMAIL_CLIENT_SECRET=
RAJ_GMAIL_REFRESH_TOKEN=
RON_GMAIL_CLIENT_ID=
RON_GMAIL_CLIENT_SECRET=
RON_GMAIL_REFRESH_TOKEN=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
FIREFLIES_API_KEY=
RON_FATHOM_API_KEY=

# --- MCP server (only needed if you're running mcp_server/http_server.py
# locally -- generate your own random values, these gate nothing real) ---
MCP_URL_SECRET=
MCP_GENERAL_URL_SECRET=
MCP_HR_URL_SECRET=
MCP_INTERN_URL_SECRET=

VAULT_ROOT=.
