[Unit]
Description=eoxs-wiki-db wiki-ingestion internal MCP server (HTTP/SSE, for headless claude -p sub-agents)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/eoxs-wiki-db
EnvironmentFile=/home/deploy/eoxs-wiki-db/.env
ExecStart=/home/deploy/eoxs-wiki-db/.venv/bin/python3 -m wiki_ingestion.mcp_http_server
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=eoxs-wiki-mcp

[Install]
WantedBy=multi-user.target
