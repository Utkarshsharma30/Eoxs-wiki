[Unit]
Description=eoxs-wiki-db raw ingestion full sweep (cron fallback)
After=network.target postgresql.service eoxs-ingestion.service
Wants=postgresql.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/eoxs-wiki-db
EnvironmentFile=/home/deploy/eoxs-wiki-db/.env
ExecStart=/home/deploy/eoxs-wiki-db/.venv/bin/python3 -m ingestion.server --sweep
StandardOutput=journal
StandardError=journal
SyslogIdentifier=eoxs-sweep
