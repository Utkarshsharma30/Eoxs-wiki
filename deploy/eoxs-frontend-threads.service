[Unit]
Description=eoxs-wiki-db frontend-threads MCP server (DB-backed save_chat_transcript, dedicated eoxs_frontend_threads database)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/eoxs-wiki-db
EnvironmentFile=/home/deploy/eoxs-wiki-db/.env
ExecStart=/home/deploy/eoxs-wiki-db/.venv/bin/python3 -m frontend_threads.mcp_server
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=eoxs-frontend-threads

[Install]
WantedBy=multi-user.target
